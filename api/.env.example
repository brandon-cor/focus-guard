# Copy to .env and fill in your values

# Neon PostgreSQL connection string — copy from Neon dashboard
# Looks like: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random string — generate with: openssl rand -base64 48
JWT_SECRET=

# Your iOS app bundle ID (e.g. com.yourname.focusguard)
# This is what Apple sets as the "aud" claim in the identity token
APPLE_CLIENT_ID=com.yourname.focusguard

# Optional — defaults to "info"
LOG_LEVEL=info
